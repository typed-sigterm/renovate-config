{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    "group:allNonMajor",
    ":configMigration",
    ":dependencyDashboardApproval",
    ":semanticCommitTypeAll(chore)"
  ],
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "ignorePresets": [
    "group:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [{
    "matchPackageNames": ["@types/vscode"],
    "enabled": false
  }, {
    "matchManagers": ["github-actions"],
    "groupName": "reusable GitHub Actions"
  }, {
    "matchDatasources": ["docker", "npm"],
    "matchPackageNames": ["@types/bun", "bun", "oven/bun"],
    "matchManagers": ["asdf"],
    "groupName": "Bun"
  }],
  "vulnerabilityAlerts": {
    "prCreation": "approval"
  }
}


